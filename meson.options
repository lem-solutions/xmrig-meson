# option('armv7', type: 'boolean', value: false, description: 'Force ARMv7 (32 bit) architecture, use with caution if automatic detection fails, but you sure it may work')


option('hwloc-debug', type: 'feature', value: 'disabled', description: 'hwloc debug helpers and log')

